<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏小图标（上课提醒用）。

  必须是纯白单色剪影：Android 5.0+ 会把通知小图标当成 alpha 蒙版处理，
  带颜色的图标会渲染成一个白色方块。

  图形是一个 3 列 × 2 行的课表网格（顶栏 + 左右中竖线 + 两条横线），
  在 24dp 下依然清晰可辨。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 外框 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,3h20v2.2H2z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,3h2.2v18H2z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.8,3H22v18h-2.2z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,18.8h20V21H2z" />
    <!-- 竖分隔 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.6,3h2.2v18H8.6z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.2,3h2.2v18h-2.2z" />
    <!-- 横分隔 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,11h20v2.2H2z" />
</vector>
