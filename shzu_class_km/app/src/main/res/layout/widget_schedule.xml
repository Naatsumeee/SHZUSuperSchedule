            android:textColor="#FF6E6E6E"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
